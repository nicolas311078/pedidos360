# Copia este archivo a `.env` y rellena los valores.
# (docker-compose lee `.env` del mismo directorio automáticamente)
# `.env` está en .gitignore: nunca se versiona. Este ejemplo es la referencia de qué va.

# --- Secreto JWT (compartido entre users y bff) ---
# Generar con, por ejemplo:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# Debe ser la MISMA en .env, en ms-pedidos360-users/.env-example y en el parámetro JwtSecret del stack AWS.
JWT_SECRET=
JWT_EXPIRATION=86400000

# --- PostgreSQL (una DB por microservicio; mismos credenciales para el lab) ---
DB_NAME=users_db
DB_USER=postgres
DB_PASSWORD=postgres

# --- Microsoft Entra ID (App Registration) ---
# Portal: portal.azure.com > Entra ID > App registrations > tu app
AZURE_CLIENT_ID=          # Application (client) ID de la App Registration
AZURE_CLIENT_SECRET=      # App > Certificates & secrets > Client Secret (solo visible al crearlo)
AZURE_TENANT_ID=          # Directory (tenant) ID (también se ve en Overview)
AZURE_REDIRECT_URI=http://localhost:8080/login/oauth2/code/azure
SPA_BASE_URL=http://localhost:4200

# Claim(s) de Entra ID que mapean a cada rol interno.
# Por defecto el claim `roles` trae el VALUE del App Role (CLIENTE/OPERADOR/ADMIN).
# Si prefieres GUIDs, pon aquí el Id del App Role en vez del value.
AZURE_ROLE_ADMIN_ID=ADMIN
AZURE_ROLE_OPERADOR_ID=OPERADOR
AZURE_ROLE_CLIENTE_ID=CLIENTE

# --- Google OAuth (opcional: con GOOGLE_CLIENT_ID vacío, Google queda deshabilitado) ---
# Console: console.cloud.google.com > APIs & Services > Credentials > OAuth 2.0 Client ID
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8080/login/oauth2/code/google

# --- RabbitMQ (mensajería asíncrona, EP3) ---
# docker-compose levanta un cluster de 2 nodos (rabbitmq-node1 / rabbitmq-node2).
# Consola de administración: http://localhost:15672 (node1) y http://localhost:15673 (node2).
RABBITMQ_USER=pedidos360
RABBITMQ_PASSWORD=pedidos360
# Cookie de Erlang compartida: es lo que permite que node2 se una al cluster de node1.
RABBITMQ_ERLANG_COOKIE=pedidos360-cluster-cookie
# Monitor de DLQ: true registra los mensajes fallidos en logs y los libera.
# false los deja retenidos en la DLQ para inspeccionarlos (util en la demo).
MESSAGING_DLQ_MONITOR_ENABLED=true