GOOGLE_CLIENT_SECRET=
# Debe coincidir con una de las redirect URIs autorizadas del OAuth client de Google
GOOGLE_REDIRECT_URI=http://localhost:8080/login/oauth2/code/google

# Claim(s) del claim "roles" de Entra ID que mapean a cada rol interno.
# Por defecto coincide con el VALUE del app role (crear los roles con estos values).
AZURE_ROLE_ADMIN_ID=ADMIN
AZURE_ROLE_OPERADOR_ID=OPERADOR
AZURE_ROLE_CLIENTE_ID=CLIENTE