JWT_SECRET=
JWT_EXPIRATION=

DB_HOST=localhost
DB_PORT=5432
DB_NAME=users_db
DB_USER=
DB_PASSWORD=

AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=
AZURE_TENANT_ID=
AZURE_REDIRECT_URI=http://localhost:8080/login/oauth2/code/azure
SPA_BASE_URL=http://localhost:4200

# Google OAuth (opcional: si GOOGLE_CLIENT_ID queda vacío, Google no se habilita)
